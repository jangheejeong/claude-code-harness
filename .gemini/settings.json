{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"$GEMINI_PROJECT_DIR\"/.gemini/hooks/block-destructive.sh"
          }
        ]
      },
      {
        "matcher": "replace|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "\"$GEMINI_PROJECT_DIR\"/.gemini/hooks/protect-secrets.sh"
          }
        ]
      }
    ]
  }
}
